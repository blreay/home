    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "最大上下文水位历史 (n_tokens_max)",
      "description": "单请求(prompt+生成)最大长度的历史曲线, 阶梯上升=出现更长会话, 归零=服务重启。红线=模型原生窗口262144, 超过即进入外推区(质量可能下降)。",
      "datasource": {
        "type": "prometheus",
        "uid": "vllm-prom"
      },
      "gridPos": {
        "h": 6,
        "w": 11,
        "x": 5,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:n_tokens_max",
          "legendFormat": "单请求最大长度"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 262144
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisLabel": "tokens",
            "thresholdsStyle": {
              "mode": "line"
            },
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
