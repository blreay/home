## cloudcli-ssh 装在 ~/.local 前缀(不用 root); 必须用 install 而不是 update:
## tnpm 默认前缀是 nvm 那个, 里面没装这个包, update 会静默 no-op 并退出 0
alias cloudcli-update='tnpm i -g --prefix "$HOME/.local" @ali/cloudcli-ssh@latest'
case ${OS} in
(Linux)
    #infocmp putty-256color >/dev/null 2>&1 && export TERM=putty-256color || export TERM=xterm
    export TERM=xterm-256color
    export TERMINFO=$NFS/.terminfo/$OS
    alias ls='ls --color=auto'
    exe="$NFSPATH/common/$OS/bin/tmux" && [[ -f $exe ]] || exe="tmux"
    #alias tmux="TERM=putty-256color $exe"
    alias tmux="$exe -2u"
    #[[ -f $NFSPATH/.dir_colors ]] && dircolors $NFSPATH/.dir_colors > /dev/null
    #eval `dircolors $NFSPATH/.dir_colors`
    #mySetPathEx PATH "$NFSPATH/common/$OS/bin:%PATH%"
    ;;
(SunOS)
    #set TERM=sun-color
    #export TERM=sun-color
    #export TERM=putty-256color
    export TERM=xterm-256color
    export TERMINFO=$NFS/.terminfo/$OS
    exe="$NFSPATH/common/$OS/bin/tmux" && [[ -f $exe ]] || exe="tmux"
    alias tmux="TERM=putty-256color $exe"
    export VIMRUNTIME=$NFS/.vim
    export VIM=$NFS/.vim
    ## 原来这里有个多余的 "::"(等于把当前目录加进 PATH), 去重函数本来就丢弃空项, 顺手删掉
    mySetPathEx PATH "/usr/xpg4/bin:%PATH%:/opt/csw/bin:$NFS/application/SunOS/csw/bin"
    #ldd $(which gls)|grep "found" >/dev/null 2>&1 || alias ls='gls --color=auto'
    #which gls >/dev/null 2>&1 && { ldd $(which gls 2>/dev/null)|grep "found" >/dev/null 2>&1 || alias ls='gls --color=auto'; }
    which gls 2>&1 | grep -v "no gls" >/dev/null 2>&1 && { ldd $(which gls 2>/dev/null)|grep "found" >/dev/null 2>&1 || alias ls='gls --color=auto'; }
    mySetPathEx LD_LIBRARY_PATH "/usr/sfw/lib/64:%LD_LIBRARY_PATH%:/usr/sfw/lib"
    ;;
(AIX)
    #export TERM=screen-256color
    export TERM=putty-256color
    export TERMINFO=$NFS/.terminfo/$OS
    export VIMRUNTIME=$NFS/.vim
    export VIM=$NFS/.vim
    mySetPathEx PATH "%PATH%:/opt/csw/bin:$NFSPATH/common/$OS/freeware/bin"
    mySetPathEx LD_LIBRARY_PATH "%LD_LIBRARY_PATH%:$NFSPATH/common/$OS/freeware/lib"
    which gls 2>&1 | grep -v "no gls" >/dev/null 2>&1 && { ldd $(which gls 2>/dev/null)|grep "found" >/dev/null 2>&1 || alias ls='gls --color=auto'; }
    exe="$NFSPATH/common/$OS/bin/tmux" && [[ -f $exe ]] || exe="tmux"
    alias tmux="TERM=putty-256color $exe -2u"
    ;;
(*)
    ;;
esac

