[[ -f "/usr/bin/vim" ]] && vimexe=/usr/bin/vim
[[ -f "/usr/local/bin/vim" ]] && vimexe=/usr/local/bin/vim
[[ -f "/usr/local/vim/bin/vim" ]] && vimexe=/usr/local/vim/bin/vim
