## 设置 PATH / LD_LIBRARY_PATH 这类冒号分隔的变量, 顺手去掉重复项.
## 用法: mySetPathEx 变量名 "新的值", 值里用 %变量名% 代表该变量的当前值:
##   mySetPathEx PATH /opt/aaa/bin:/opt/bbb/bin:%PATH%
##   mySetPathEx PATH %PATH%:/opt/aaa/bin:/opt/bbb/bin
##   mySetPathEx PATH /opt/aaa/bin:%PATH%:/opt/bbb/bin
##   mySetPathEx LD_LIBRARY_PATH /opt/aaa/lib:%LD_LIBRARY_PATH%:/opt/bbb/lib
##   mySetPathEx PATH                      ## 只给变量名 = 就地去重整理当前值
## 规则: 重复项只保留第一次出现的那个; 空项(连续的 :: 以及首尾的 :)一律丢弃.
## 占位符用 %VAR% 而不是 <VAR>: < > 是重定向符号, 漏了引号就会被 bash 当成"从名为
## PATH 的文件读入", 而当前目录恰好有同名文件时它会安静地成功. 换成 % 没有这个坑,
## 纯字面量的值也就不必加引号了. 但值里一旦出现 $ / 反引号 / $( ) / 空格, 引号仍然
## 必须加 —— 否则参数会被 shell 拆开, 下面那道 $# 检查会报错退出(不会动 PATH).
## 本文件 zsh 也会 source(.zshrc.my 里有一行), 所以函数体内只用 bash/zsh 都成立的写法.
function mySetPathEx {
    local _mspe_var="$1" _mspe_pat="$2"
    local _mspe_cur="" _mspe_ph="" _mspe_new="" _mspe_head="" _mspe_rest=""
    local _mspe_seen=":" _mspe_out="" _mspe_item
    ## 漏写引号时第二个参数会被拆成好几段, 只取 $2 会让 PATH 静默塌成一条, 这里拦住
    ## (zsh 默认不对未加引号的展开做词分割, 所以这道检查只在 bash 里会触发)
    if (( $# > 2 )); then
        printf 'mySetPathEx: got %d args, 第二个参数漏引号了?(值里有空格/被 shell 拆开)\n' "$#" >&2
        return 2
    fi
    case "$_mspe_var" in
    (''|*[!A-Za-z_0-9]*|[0-9]*)
        printf 'mySetPathEx: bad variable name: %s\n' "$_mspe_var" >&2; return 2 ;;
    esac
    if [[ -z "$_mspe_pat" ]]; then _mspe_pat="%$_mspe_var%"; fi
    ## 用 eval 取间接值: bash 的 ${!var} 在 zsh 里是 bad substitution, zsh 的 ${(P)var}
    ## bash 又不认; eval 两边都成立(变量名上面已经校验过字符集, 不会被注入)
    eval "_mspe_cur=\${$_mspe_var}"
    ## 手工展开 %VAR% 占位符而不用 ${x//pat/repl}: bash 5.2+ 的替换文本里 & 表示
    ## "整段匹配", 当前值一旦含 & 就会被改坏
    _mspe_ph="%$_mspe_var%"
    _mspe_rest="$_mspe_pat"
    while [[ "$_mspe_rest" == *"$_mspe_ph"* ]]; do
        _mspe_head="${_mspe_rest%%"$_mspe_ph"*}"
        _mspe_rest="${_mspe_rest#*"$_mspe_ph"}"
        _mspe_new="$_mspe_new$_mspe_head$_mspe_cur"
    done
    _mspe_new="$_mspe_new$_mspe_rest"
    ## 按 : 切开(路径里允许有空格), 丢掉空项和已经出现过的项(保留第一次出现的位置)
    ## 手工循环, 不用 read -a(bash) / read -A(zsh): 两边选项名不同, 数组下标基也不同
    ## (zsh 从 1 开始), 手工切分顺便就不用碰 IFS 了
    _mspe_rest="${_mspe_new}:"
    while [[ -n "$_mspe_rest" ]]; do
        _mspe_item="${_mspe_rest%%:*}"
        _mspe_rest="${_mspe_rest#*:}"
        if [[ -z "$_mspe_item" ]]; then continue; fi
        case "$_mspe_seen" in (*":${_mspe_item}":*) continue ;; esac
        _mspe_seen="$_mspe_seen${_mspe_item}:"
        if [[ -n "$_mspe_out" ]]; then _mspe_out="$_mspe_out:"; fi
        _mspe_out="$_mspe_out$_mspe_item"
    done
    export "$_mspe_var=$_mspe_out"
}

function set_proxy {
[[ "no" == "$1" ]] && unset http_proxy HTTP_PROXY https_proxy ftp_proxy no_proxy && echo "proxy has been disabled $(env|grep -i proxy)" && return
export HTTP_PROXY=http://cn-proxy.jp.oracle.com:80
[[ "us" == "$1" ]] && export HTTP_PROXY=http://www-proxy.us.oracle.com:80
export http_proxy=$HTTP_PROXY
export https_proxy=$HTTP_PROXY
export ftp_proxy=$HTTP_PROXY
export no_proxy=dl.google.com
export GOPROXY=https://goproxy.cn,direct
env|grep -i proxy
}
function set_java {
mySetPathEx PATH "$JAVA_HOME/bin:$MAVEN_HOME/bin:$DERBY_HOME/bin:NFS/application/Linux/eclipse:%PATH%"
mySetPathEx LD_LIBRARY_PATH "$JAVA_HOME/lib:$MAVEN_HOME/lib:$DERBY_HOME/lib:%LD_LIBRARY_PATH%"
}
function set_cn {
export LANG="zh_CN.UTF-8"
export LC_ALL="zh_CN.UTF-8"
}
function set_en {
    ## set code page for windows command to english, chinese code page is "936"
    chcp.com 437
}
function set_vimrc {
vimnewrc1=$NFS/.vim.bk/.vimrc.conf
vimnewrc2=$HOME/.vim.bk/.vimrc.conf
#axx1xx
while read line; do eval $line; done <<-EOF
$({ test -f $vimnewrc1 && DISPLAY= gpg -o - $vimnewrc1 2>/dev/null; }  || { test -f $vimnewrc2 && DISPLAY= gpg -o - $vimnewrc2 2>/dev/null; })
EOF
}

function jesdate {
perl <<-\EOF
use Time::HiRes;
($sec,$min,$hour,$mday,$mon,$year,$wday,$yday,$isdst) = localtime();
($s, $usec) = Time::HiRes::gettimeofday();
printf("%04d%02d%02d %02d:%02d:%02d.%03d\n", $year+1900, $mon+1, $mday+1, $hour, (($s-$s%60)/60)%60, $s%60, $usec/1000);
EOF
}

function my_sync_skill {
  mkdir -p $HOME/.codefuse/engine/cc/skills
  for i in $HOME/skills/*; do ln -svnf $i $HOME/.codefuse/engine/cc/skills/; done
  mkdir -p $HOME/.claude/skills
  for i in $HOME/skills/*; do ln -svnf $i $HOME/.claude/skills/; done
}

